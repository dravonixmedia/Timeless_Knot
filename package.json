{
  "name": "timeless-knot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run media --silent && next dev",
    "build": "node scripts/media/generate-image-manifest.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "node --test \"scripts/media/*.test.mjs\" \"tests/*.test.mjs\"",
    "media": "node scripts/media/generate-image-manifest.mjs",
    "media:check": "node scripts/media/generate-image-manifest.mjs --strict",
    "postinstall": "node scripts/media/generate-image-manifest.mjs --quiet",
    "cf:build": "opennextjs-cloudflare build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.11",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "image-size": "2.0.4",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.0"
  }
}
