{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timeless-knot",
  // Worker entry generated by `opennextjs-cloudflare build` — never a raw .next server file.
  "main": "custom-worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the OpenNext cache layer; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "timeless-knot"
    }
  ],
  "images": {
    // Cloudflare Images binding used by OpenNext for next/image optimisation.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  },
  // Worker Previews (`wrangler preview`, used for non-production branches).
  // Previews take their bindings only from this block; assets, `main` and
  // compatibility settings are inherited from above. Service bindings are not
  // supported in Previews, so WORKER_SELF_REFERENCE is intentionally absent —
  // OpenNext only uses it for ISR revalidation, which this site does not use.
  "previews": {
    "images": {
      "binding": "IMAGES"
    }
  }
}
