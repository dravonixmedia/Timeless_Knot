{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "timeless-knot",
  // Worker entry generated by `opennextjs-cloudflare build` — never a raw .next server file.
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference used by the OpenNext cache layer; must match "name".
      "binding": "WORKER_SELF_REFERENCE",
      "service": "timeless-knot"
    }
  ],
  "images": {
    // Cloudflare Images binding used by OpenNext for next/image optimisation.
    "binding": "IMAGES"
  },
  "observability": {
    "enabled": true
  }
}
