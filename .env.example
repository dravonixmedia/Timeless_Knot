# Public URL of the production site — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Server-side endpoint that receives enquiry submissions as JSON (e.g. a form
# service or CRM webhook). When unset, the contact form runs in clearly
# labelled demonstration mode and never reports a false success.
ENQUIRY_WEBHOOK_URL=

# WhatsApp number for the floating enquiry button and WhatsApp links, in
# international format with country code (e.g. +91 98765 43210). Inlined at
# build time, so set it as a Cloudflare *build* variable. When unset or invalid,
# every WhatsApp button and link is hidden.
NEXT_PUBLIC_WHATSAPP_NUMBER=
