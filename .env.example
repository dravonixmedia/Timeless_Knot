# Public URL of the production site — used for canonical URLs, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=

# Server-side endpoint that receives enquiry submissions as JSON (e.g. a form
# service or CRM webhook). When unset, the contact form runs in clearly
# labelled demonstration mode and never reports a false success.
ENQUIRY_WEBHOOK_URL=

# OPTIONAL. The recommended place for the WhatsApp link is WHATSAPP_URL in
# src/config/site.ts (committed, so it can never go missing in a build).
# This variable is only a fallback when that is null. It is read at BUILD time,
# so in Cloudflare it must be a *Build* variable, not a runtime variable.
# Format: https://wa.me/<country code + number>  or  https://wa.me/message/<code>
NEXT_PUBLIC_WHATSAPP_URL=
