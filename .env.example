# Canonical production origin (a BUILD variable in Cloudflare). Drives canonical
# URLs, sitemap, robots.txt, Open Graph, structured data and the Worker's host
# rules. Unset = https://timelessknot.dravonix.dev (src/lib/indexing.ts). Must be
# a bare HTTPS origin. Set to https://timelessknot.in only after that domain is
# verified on Cloudflare with HTTPS — see docs/DOMAIN-MIGRATION.md.
NEXT_PUBLIC_SITE_URL=

# Server-side endpoint that receives enquiry submissions as JSON (e.g. a form
# service or CRM webhook). NOT CONFIGURED YET: the contact form is not connected
# to a production enquiry destination. When unset, the contact form runs in clearly
# labelled demonstration mode and never reports a false success.
ENQUIRY_WEBHOOK_URL=

# OPTIONAL. The recommended place for the WhatsApp link is WHATSAPP_URL in
# src/config/site.ts (committed, so it can never go missing in a build).
# This variable is only a fallback when that is null. It is read at BUILD time,
# so in Cloudflare it must be a *Build* variable, not a runtime variable.
# Format: https://wa.me/<country code + number>  or  https://wa.me/message/<code>
NEXT_PUBLIC_WHATSAPP_URL=
